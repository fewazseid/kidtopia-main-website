# Environment Variables
# Add your environment variables here

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: The URL of your backend API (e.g., Cloud Run URL). 
# Required if frontend and backend are deployed separately.
VITE_API_URL=""

# VITE_LARAVEL_LOGIN_URL: System login (Laravel Cloud). Website has no local login.
VITE_LARAVEL_LOGIN_URL="https://kidtopia-main-u5x6pj.laravel.cloud/login"

# Email Configuration (100% Free via Gmail)
# Use your regular Google Account and generate an App Password
# Instructions: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-app-password"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "admin@kidtopiaet.com" ||
        request.auth.token.email == "system_worker@kidtopiaet.internal" ||
        request.auth.token.email == "system_worker_v2@kidtopiaet.internal" ||
        ('email' in request.auth.token && request.auth.token.email.matches('.*@kidtopiaet\\.internal'))
      );
    }

    // Users Collection (for roles)
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Settings Collection (Tour layouts and Admin options)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings Collection (Public metadata)
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow update: if resource.data.status == 'pending' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time']);
      allow delete: if isAdmin();
    }

    // Booking Details Collection (PII)
    match /booking_details/{bookingId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Content Collection (Translations)
    match /content/{lang} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

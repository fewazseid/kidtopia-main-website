rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token) && (
          request.auth.token.email == "fewazseidahmed@gmail.com" ||
          request.auth.token.email == "admin@kidtopiaet.com" ||
          request.auth.token.email == "worker_8ffecb1d_secured_2026@kidtopiaet.internal"
        )
      ) || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isAuthorizedPersonnel() {
      return isAdmin() || isStaff();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (for roles and parent profiles)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAuthorizedPersonnel());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Settings Collection (Tour layouts, virtual tour 360, gallery, screenshots, admin config, language config)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings Collection (Public metadata)
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthorizedPersonnel() || (resource.data.status == 'pending' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'time', 'branch']));
      allow delete: if isAdmin();
    }

    // Booking Details Collection (Private PII)
    match /booking_details/{bookingId} {
      allow create: if true;
      allow read: if isAuthorizedPersonnel();
      allow update: if isAuthorizedPersonnel();
      allow delete: if isAdmin();
    }

    // Content Collection (Translations)
    match /content/{lang} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter Subscribers Collection
    match /newsletter_subscribers/{subscriberId} {
      allow read: if isAuthorizedPersonnel();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
